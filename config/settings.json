{
  "database": {
    "type": "sqlite",
    "path": "database/contacts.db",
    "backup_enabled": true,
    "backup_interval_hours": 24
  },
  "browser": {
    "chrome_debug_port": 9222,
    "user_data_dir": "chrome_user_data",
    "headless": false,
    "window_size": [1920, 1080],
    "page_load_timeout": 30
  },
  "scraping": {
    "request_delay_min": 2,
    "request_delay_max": 5,
    "retry_attempts": 3,
    "retry_delay": 10,
    "user_agents": [
      "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    ]
  },
  "safety_limits": {
    "max_daily_friend_requests": 50,
    "max_daily_emails": 100,
    "friend_request_delay_min": 30,
    "friend_request_delay_max": 60,
    "email_delay_min": 10,
    "email_delay_max": 30
  },
  "email": {
    "smtp_server": "smtp.gmail.com",
    "smtp_port": 587,
    "use_tls": true,
    "username": "",
    "password": "",
    "from_name": "",
    "templates_path": "config/email_templates.json"
  },
  "filtering": {
    "min_match_score": 0.3,
    "preview_count": 5,
    "enable_ai_filtering": true,
    "weights": {
      "embedding_similarity": 0.3,
      "company_match": 0.4,
      "job_keywords": 0.3
    },
    "rule_scores": {
      "company_exact_match": 0.8,
      "company_partial_match": 0.5,
      "job_keyword_match": 0.3
    }
  },
  "embedding_model": {
    "enabled": true,
    "model_name": "${ZHIPU_EMBEDDING_MODEL:-embedding-3}",
    "api_base": "${ZHIPU_EMBEDDING_BASE}",
    "api_key": "${ZHIPU_EMBEDDING_KEY}",
    "dimensions": 512,
    "timeout": 60,
    "batch_size": 50
  },
  "llm_enhancement": {
    "enabled": true,
    "model_name": "${ZHIPU_MODEL}",
    "api_base": "${ZHIPU_API_BASE}",
    "api_key": "${ZHIPU_API_KEY}",
    "max_tokens": 2000,
    "temperature": 0.2,
    "thinking_type": "enabled",
    "timeout": 60
  },
  "logging": {
    "level": "WARNING",
    "file_path": "logs/system.log",
    "max_file_size_mb": 10,
    "backup_count": 5,
    "console_output": false,
    "console_level": "ERROR"
  }
}
